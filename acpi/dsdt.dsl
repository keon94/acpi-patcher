                                Divide ((POE1 * 0x03E8), 0x64, Local0, Local1)
                                Local1 = TL00 (Local1)
                                DPV1 = Local1
                                DPV2 = Local1
                            }

                            DPV3 = (POE1 * 0x03E8)
                            If ((HPTX == 0x02))
                            {
                                DPV4 = 0x012C
                                DPV5 = 0x0A
                            }
                            Else
                            {
                                DPV4 = 0x01F4
                                DPV5 = 0x1E
                            }
                        }
                    }

                    If ((((^PCI0.LPC0.EC0.BOL0 == Zero) || (^PCI0.LPC0.EC0.BDPF == One)) && (^PCI0.LPC0.EC0.TCAD == Zero)))
                    {
                        DPV1 = 0xAFC8
                        DPV2 = 0xD2F0
                        DPV3 = 0xFDE8
                    }

                    If ((ToInteger (Arg1) == Zero))
                    {
                        DPV6 = 0x00011170
                        DPV7 = 0x000222E0
                    }
                    ElseIf ((ToInteger (Arg1) == 0x02))
                    {
                        DPV6 = 0x00011170
                        DPV7 = 0x000222E0
                    }
                    Else
                    {
                        DPV6 = 0x000186A0
                        DPV7 = 0x00025D78
                    }

                    If ((DPV1 < 0x3A98))
                    {
                        DPV1 = 0x3A98
                    }

                    If ((DPV2 < 0x3A98))
                    {
                        DPV2 = 0x3A98
                    }

                    If ((DPV3 < 0x3A98))
                    {
                        DPV3 = 0x3A98
                    }

                    If ((DPV4 < 0x32))
                    {
                        DPV4 = 0x32
                    }

                    If ((DPV5 < One))
                    {
                        DPV5 = One
                    }

                    DPV8 = 0x64
                    If ((ToInteger (Arg1) != 0x03))
                    {
                        ALIB (0x0C, XX11)
                        Sleep (0x0A)
                    }

                    If ((ToInteger (Arg1) != Zero))
                    {
                        ^PCI0.LPC0.EC0.WLIS = Zero
                    }
                    ElseIf ((SUBM != Zero))
                    {
                        ^PCI0.LPC0.EC0.WLIS = One
                    }

                    Release (VPCM)
                }
            }
        }

