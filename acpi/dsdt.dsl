    Method (CSAD, 0, NotSerialized)
    {
        If ((\_SB.PCI0.LPC0.EC0.ADPT == Zero))
        {
            Return (Zero)
        }

        If ((\_SB.PCI0.LPC0.EC0.TCAD == One))
        {
            Return (Zero)
        }

        If ((\_SB.PCI0.LPC0.EC0.ADPS == 0x03))
        {
            Return (Zero)
        }

        If ((PMID == One))
        {
            If (((\_SB.PCI0.LPC0.EC0.ACWT == 0x87) && (PGID == 0x02)))
            {
                Return (Zero)
            }
        }
        ElseIf ((\_SB.PCI0.LPC0.EC0.ACWT == 0x87))
        {
            Return (Zero)
        }

        Return (One)
    }

    Method (DGHP, 1, NotSerialized)
    {
        If ((Arg0 == One))
        {
            Debug = "DGHP Plug In"
            DGST = One
            If ((DGBS == One))
            {
                DGBS = Zero
            }

            \_SB.PCI0.GPP0.PG00._ON ()
            Sleep (0x64)
            If ((PMID == One))
            {
                If ((DDS0 == Zero)){}
            }
            Else
            {
            }

            Notify (\_SB.PCI0.GPP0.PEGP, Zero) // Bus Check
        }
        Else
        {
            Debug = "DGHP Plug Out"
            If ((M009 (PWOK) == One))
            {
                Debug = "DGHP DGPU_PWR_OK=1"
                Debug = "DGHP Plug Out - DGBS=1"
                DGBS = One
            }
            Else
            {
                Debug = "DGHP Plug Out - eject device"
                Notify (\_SB.PCI0.GPP0.PEGP, 0x03) // Eject Request
                Notify (\_SB.PCI0.GPP0.PEGP, Zero) // Bus Check
            }
        }
    }

