    Scope (_TZ)
    {
        Device (FAN5)
        {
            Name (QFAN, Zero)
            Name (_HID, EisaId ("PNP0C0B") /* Fan (Thermal Solution) */)  // _HID: Hardware ID
            Name (TFST, Package (0x03)
            {
                Zero, 
                0xFFFFFFFF, 
                0xFFFFFFFF
            })
            Method (_FST, 0, Serialized)  // _FST: Fan Status
            {
                Local0 = (\_SB.PCI0.LPC0.EC0.FA2S * 0x64)
                TFST [0x02] = Local0
                If ((DerefOf (TFST [0x02]) > Zero))
                {
                    TFST [One] = One
                }
                Else
                {
                    TFST [One] = Zero
                }

                Return (TFST) /* \_TZ_.FAN5.TFST */
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                If ((Arg0 == ToUUID ("a7611840-99fe-41ae-a488-35c75926c8eb") /* Fan Trip Points */))
                {
                    Switch (ToInteger (Arg2))
                    {
                        Case (Zero)
                        {
                            Return (Buffer (One)
                            {
                                 0x0F                                             // .
                            })
                        }
                        Case (One)
                        {
                            Return (0x64)
                        }
                        Case (0x02)
                        {
                            Local1 = DerefOf (Arg3 [Zero])
                            Local2 = DerefOf (Arg3 [One])
                            If ((Local1 >= 0x64))
                            {
                                \_SB.PCI0.LPC0.EC0.FANL = (Local1 / 0x64)
                                \_SB.PCI0.LPC0.EC0.FANH = (Local2 / 0x64)
                            }
                            Else
                            {
                                \_SB.PCI0.LPC0.EC0.FANL = Local1
                                \_SB.PCI0.LPC0.EC0.FANH = Local2
                            }

                            Return (Zero)
                        }
                        Case (0x03)
                        {
                            If ((PMID == One))
                            {
                                Return (Package (0x04)
                                {
                                    0x0640, 
                                    0x076C, 
                                    0x07D0, 
                                    0x270F
                                })
                            }
                            ElseIf ((PGID == One))
                            {
                                If ((ToInteger (DCID) == Zero))
                                {
                                    Return (Package (0x04)
                                    {
                                        0x0708, 
                                        0x0834, 
                                        0x0898, 
                                        0x270F
                                    })
                                }
                                Else
                                {
                                    Return (Package (0x04)
                                    {
                                        0x06A4, 
                                        0x076C, 
                                        0x0834, 
                                        0x270F
                                    })
                                }
                            }
                            Else
                            {
                                Return (Package (0x04)
                                {
                                    0x06A4, 
                                    0x076C, 
                                    0x0834, 
                                    0x270F
                                })
                            }
                        }
                        Default
                        {
                            Return (Buffer (One)
                            {
                                 0x00                                             // .
                            })
                        }

                    }
                }
                Else
                {
                    Return (Buffer (One)
                    {
                         0x00                                             // .
                    })
                }
            }
        }
    }
}

