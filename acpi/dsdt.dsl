        })
        CreateWordField (BF00, Zero, TMIT)
        Method (NVDB, 0, Serialized)
        {
            If ((PMID == Zero))
            {
                Switch (ToInteger (PGID))
                {
                    Case (Zero)
                    {
                        CopyObject (DB00, Local1)
                    }
                    Case (One)
                    {
                        If ((ToInteger (DCID) == Zero))
                        {
                            CopyObject (DB01, Local1)
                        }
                        Else
                        {
                            CopyObject (DB02, Local1)
                        }
                    }
                    Case (0x02)
                    {
                        CopyObject (DB03, Local1)
                    }
                    Case (0x03)
                    {
                        CopyObject (DB04, Local1)
                    }
                    Default
                    {
                        CopyObject (DB04, Local1)
                    }

                }
            }
            ElseIf ((HPTX == 0x02))
            {
                Switch (ToInteger (PGID))
                {
                    Case (Zero)
                    {
                        CopyObject (DB10, Local1)
                    }
                    Case (One)
                    {
                        CopyObject (DB11, Local1)
                    }
                    Default
                    {
                        CopyObject (DB10, Local1)
                    }

                }
            }
            Else
            {
                Switch (ToInteger (PGID))
                {
                    Case (Zero)
                    {
                        CopyObject (DB05, Local1)
                    }
                    Case (One)
                    {
                        CopyObject (DB06, Local1)
                    }
                    Case (0x02)
                    {
                        If ((ADWT >= 0xE6))
                        {
                            CopyObject (DB09, Local1)
                        }
                        ElseIf ((PBSP == One))
                        {
                            CopyObject (DB09, Local1)
                        }
                        Else
                        {
                            CopyObject (DB07, Local1)
                        }
                    }
                    Default
                    {
                        CopyObject (DB08, Local1)
                    }

                }
            }

            If ((ToInteger (^PCI0.LPC0.EC0.GZ44) == 0x03))
            {
                ^NPCF.DBAC = Zero
            }
            ElseIf ((ToInteger (^PCI0.LPC0.EC0.GZ44) == 0x07))
            {
                If ((PMID == Zero))
                {
                    If ((RXMS (0x71) == One))
                    {
                        Local2 = (DerefOf (DerefOf (Local1 [0x04]) [One]) - 0x0A)
                        ^NPCF.ACBT = (Local2 * 0x08)
                        ^NPCF.AMAT = (DerefOf (DerefOf (Local1 [0x04]) [0x02]) * 0x08)
                        TMIT = (DerefOf (DerefOf (Local1 [0x04]) [0x03]) * 0x08)
                        ^NPCF.AMIT = (~TMIT + One)
                        ^NPCF.ATPP = (DerefOf (DerefOf (Local1 [0x04]) [0x04]) * 0x08)
                        ^NPCF.DBAC = DerefOf (DerefOf (Local1 [0x04]) [0x05])
                    }
                    ElseIf ((RXMS (0x71) == 0x02))
                    {
                        Local2 = (DerefOf (DerefOf (Local1 [0x04]) [One]) - 0x14)
                        ^NPCF.ACBT = (Local2 * 0x08)
                        ^NPCF.AMAT = (DerefOf (DerefOf (Local1 [0x04]) [0x02]) * 0x08)
                        TMIT = (DerefOf (DerefOf (Local1 [0x04]) [0x03]) * 0x08)
                        ^NPCF.AMIT = (~TMIT + One)
                        ^NPCF.ATPP = (DerefOf (DerefOf (Local1 [0x04]) [0x04]) * 0x08)
                        ^NPCF.DBAC = DerefOf (DerefOf (Local1 [0x04]) [0x05])
                    }
                    ElseIf ((RXMS (0x71) == 0x03))
                    {
                        Local2 = (DerefOf (DerefOf (Local1 [0x04]) [One]) - 0x1E)
                        ^NPCF.ACBT = (Local2 * 0x08)
                        ^NPCF.AMAT = (DerefOf (DerefOf (Local1 [0x04]) [0x02]) * 0x08)
                        TMIT = (DerefOf (DerefOf (Local1 [0x04]) [0x03]) * 0x08)
                        ^NPCF.AMIT = (~TMIT + One)
                        ^NPCF.ATPP = (DerefOf (DerefOf (Local1 [0x04]) [0x04]) * 0x08)
                        ^NPCF.DBAC = DerefOf (DerefOf (Local1 [0x04]) [0x05])
                    }
                    Else
                    {
                        ^NPCF.ACBT = (DerefOf (DerefOf (Local1 [0x04]) [One]) * 0x08)
                        ^NPCF.AMAT = (DerefOf (DerefOf (Local1 [0x04]) [0x02]) * 0x08)
                        TMIT = (DerefOf (DerefOf (Local1 [0x04]) [0x03]) * 0x08)
                        ^NPCF.AMIT = (~TMIT + One)
                        ^NPCF.ATPP = (DerefOf (DerefOf (Local1 [0x04]) [0x04]) * 0x08)
                        ^NPCF.DBAC = DerefOf (DerefOf (Local1 [0x04]) [0x05])
